{
  "name": "fincore",
  "private": true,
  "description": "FinCore: SIMULATED digital wallet, double-entry ledger and payment processing platform (educational assessment).",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
