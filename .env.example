# Copy to .env for local use. Every value here is a PLACEHOLDER for local development only.
# Never commit .env. Staging/production values are injected from GitHub Environments or VM secret files.

APP_ENV=development
LOG_LEVEL=info
ANALYTICS_LOG_LEVEL=INFO

# Public edge (Caddy). Locally ":80" serves plain HTTP; on the VM set the domain to get automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# PostgreSQL (container on the internal `data` network)
POSTGRES_DB=fincore
# Superuser: used ONLY by the one-time role bootstrap (db/bootstrap/roles.sql). No service connects as it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
# Roles created by the bootstrap (ADR-006)
FINCORE_OWNER_PASSWORD=change-me-local-only
FINCORE_API_PASSWORD=change-me-local-only
FINCORE_WORKERS_PASSWORD=change-me-local-only
FINCORE_ANALYTICS_PASSWORD=change-me-local-only

# App secrets (local placeholders; generate real ones per environment, see infra/deploy/README.md)
MFA_ENC_KEY=ZmluY29yZS1sb2NhbC1kZXYtb25seS1tZmEta2V5ISE=
ANALYTICS_TOKEN=local-dev-only-analytics-token
WEBHOOK_SECRET=local-dev-only-webhook-secret
# JWT_PRIVATE_KEY_PEM / JWT_PUBLIC_KEY_PEM: required in staging/production (Ed25519 PEM, newlines escaped as \n)

# Redis
REDIS_PASSWORD=change-me-local-only

# For running the api on the host (pnpm dev). Matches `pnpm db:local` (embedded Postgres, no Docker),
# whose default local passwords are "local-dev-only".
DATABASE_URL=postgres://fincore_api:local-dev-only@127.0.0.1:54320/fincore
REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# Seed: password for all synthetic demo users (pnpm db:local --seed)
SEED_DEMO_PASSWORD=FinCore-Demo-2026!

IMAGE_TAG=local
